{
  "version": 3,
  "description": "Master registry — single source of truth for Al Burhan ERP. Reflects ONLY what is implemented. Out-of-scope features are listed in outOfScope[]. Hidden pages (no sidebar entry by design) are auto-detected by update-snapshot.mjs into nav-snapshot.hiddenAdminPages.",
  "updatedAt": "2026-07-22",
  "_auditPolicy": {
    "failOnlyFor": [
      "missing route",
      "React error",
      "API failure",
      "blank screen",
      "permission failure",
      "broken navigation"
    ],
    "neverFailFor": [
      "outOfScope features",
      "planned modules",
      "future releases"
    ],
    "sourceOfTruth": "implemented application (navigation.ts + App.tsx + component files)"
  },
  "outOfScope": [
    {
      "id": "receipts",
      "label": "Receipts (Standalone Page)",
      "coveredBy": "/admin/invoices + /admin/payments",
      "reason": "Receipt generation is embedded in Bookings and Invoices; no standalone receipt ledger needed in this release."
    },
    {
      "id": "refunds",
      "label": "Refunds",
      "coveredBy": "/admin/payment-trash",
      "reason": "No standalone admin refund management module in this release. Voided payments go to Payment Trash."
    },
    {
      "id": "cms",
      "label": "CMS (Content Management)",
      "coveredBy": "n/a",
      "reason": "Content management not implemented in this release."
    },
    {
      "id": "backup_manager",
      "label": "Backup Manager",
      "coveredBy": "n/a",
      "reason": "Database backup tooling not implemented in this release."
    },
    {
      "id": "login_logs",
      "label": "Login Logs",
      "coveredBy": "/admin/audit-logs",
      "reason": "Login events are captured in Audit Logs. No dedicated login-log page in this release."
    },
    {
      "id": "activity_logs",
      "label": "Activity Logs",
      "coveredBy": "/admin/audit-logs",
      "reason": "Activity is captured in Audit Logs. No dedicated activity-log page in this release."
    }
  ],
