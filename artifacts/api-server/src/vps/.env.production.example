# ══════════════════════════════════════════════════════════════════════════════
#  Al Burhan Tours & Travels — VPS Production Environment
#  File: /var/www/alburhan/.env
#  Copy this file, rename to .env, and fill in all values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SITE_BASE=https://alburhantravels.online

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql://alburhan:YOUR_DB_PASSWORD@localhost:5432/alburhan_db

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the main API server
CORS_ORIGIN=https://alburhantravels.online,https://www.alburhantravels.online

# ── Razorpay Payments ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_SECRET=YOUR_RAZORPAY_SECRET

# ── BotBee WhatsApp ───────────────────────────────────────────────────────────
BOTBEE_API_KEY=YOUR_BOTBEE_API_KEY
BOTBEE_BUSINESS_ID=YOUR_BOTBEE_BUSINESS_ID
BOTBEE_PHONE_NUMBER_ID=965912196611113

# ── Fast2SMS (OTP / DLT SMS) ──────────────────────────────────────────────────
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@alburhantravels.online
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM=Al Burhan Tours <info@alburhantravels.online>

# ── Migration / Deploy ────────────────────────────────────────────────────────
MIGRATION_KEY=alburhan-migrate-2026
# Leave blank — on VPS you no longer need to pull from Replit dev:
REPLIT_DEV_URL=

# ── Object Storage ────────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=YOUR_BUCKET_ID
PRIVATE_OBJECT_DIR=private_uploads
PUBLIC_OBJECT_SEARCH_PATHS=uploads,private_uploads

# ── Admin ─────────────────────────────────────────────────────────────────────
DELETE_ADMIN_PASSWORD=YOUR_SECURE_DELETE_PASSWORD

# ── PDF Enterprise Session ────────────────────────────────────────────────────
PDF_SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
